# Local runner: no cloud requests or paid fallback unless explicitly selected.
PROFILE=local
HOST=127.0.0.1
PORT=4317
TARGET_LANGUAGE=ko
EVENT_NAME=Bitcoin++
STAGE_NAME=Main Stage

# Install/run local model services separately. All local endpoints use loopback.
LOCAL_STT_URL=http://127.0.0.1:8080/inference
TRANSLATION_BASE_URL=http://127.0.0.1:11434/v1
TRANSLATION_MODEL=qwen3:8b
LOCAL_TTS_URL=http://127.0.0.1:8880/v1/audio/speech
LOCAL_TTS_MODEL=
LOCAL_TTS_VOICE=

# Explicit cloud choices: recognition local/elevenlabs/xai;
# translation local/openrouter/xai; speech local/elevenlabs/xai.
# The hosted Cloudflare profile also supports workers-ai at all three stages.
# STT_PROVIDER=elevenlabs
# TRANSLATION_PROVIDER=openrouter
# TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENROUTER_API_KEY=
XAI_API_KEY=
XAI_VOICE=eve

# Reachable HTTPS origin for remote phones using the local runner.
PUBLIC_BASE_URL=
# Omit capability overrides to generate private files under .runtime/.
OPERATOR_TOKEN=
VIEWER_TOKEN=
